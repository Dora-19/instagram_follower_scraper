PROVIDER=socialblade+serp
INSTAGRAM_USERNAME=your_login_username
INSTAGRAM_PASSWORD=your_login_password
INSTAGRAM_SESSION_FILE=.session-instaloader
MAX_CONCURRENCY=3
REQUESTS_PER_MINUTE=30
MAX_RETRIES=3
BACKOFF_BASE_SECONDS=2

# Social Blade provider — no API key needed
# SOCIALBLADE_DELAY_SECONDS=2.0   # polite delay between requests (seconds)
# SOCIALBLADE_TIMEOUT=15

# SERP fallback — sign up free at https://serpapi.com (100 free queries/month)
# SERP_API_KEY=your_serpapi_key_here
# SERP_TIMEOUT=10

# Browserbase provider (optional)
# PROVIDER=browserbase
# BROWSERBASE_CDP_URL=wss://connect.browserbase.com?apiKey=YOUR_KEY&projectId=YOUR_PROJECT_ID
# BROWSERBASE_PROFILE_URL_TEMPLATE=https://www.instagram.com/{username}/
# BROWSERBASE_TIMEOUT_MS=30000
# BROWSERBASE_STORAGE_STATE=.browserbase_state.json

# Bright Data provider (optional)
# PROVIDER=brightdata
# BRIGHTDATA_CDP_URL=wss://brd-customer-<id>-zone-<zone>:<password>@brd.superproxy.io:9222
# BRIGHTDATA_PROFILE_URL_TEMPLATE=https://www.instagram.com/{username}/
# BRIGHTDATA_TIMEOUT_MS=30000
# BRIGHTDATA_STORAGE_STATE=.brightdata_state.json
